import FreeCAD as App, Mesh
paths=[r"C:\Users\workf\OneDrive\Documents\visrodeck_case_v6.FCStd", r"C:\Users\workf\OneDrive\Documents\visrodeck_case_v6_color.FCStd"]
f=open(r"D:\EMTYPYIE\Kohlrausch\work\case-model-inspect.txt","w")
for p in paths:
 d=App.openDocument(p); d.recompute(); f.write("DOC "+p+"\n")
 for o in d.Objects:
  if hasattr(o,"Shape") and not o.Shape.isNull():
   b=o.Shape.BoundBox; f.write(f"SHAPE {o.Name} {o.Label} type={o.TypeId} solids={len(o.Shape.Solids)} faces={len(o.Shape.Faces)} bounds={b}\n")
 for o in d.Objects:
  if hasattr(o,"Mesh") and not o.Mesh.isNull():
   f.write(f"MESH {o.Name} {o.Label} facets={o.Mesh.CountFacets} bounds={o.Mesh.BoundBox}\n")
 App.closeDocument(d.Name)
f.close()
for p in [r"C:\Users\workf\OneDrive\Documents\visrodeck_tray_v6.stl", r"C:\Users\workf\OneDrive\Documents\visrodeck_tray_v6.3mf"]:
 try:
  m=Mesh.Mesh(p); print("MESHFILE",p,"facets",m.CountFacets,"bounds",m.BoundBox)
 except Exception as e: print("MESHFILE ERROR",p,e)
