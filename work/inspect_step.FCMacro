import FreeCAD as App
import Part

path = r"D:\DownLoad-D\kohlrausch_visrodeck.step"
doc = App.newDocument("ReadOnlyInspect")
Part.insert(path, doc.Name)
doc.recompute()
print("objects", len(doc.Objects))
for obj in doc.Objects:
    if not hasattr(obj, "Shape") or obj.Shape.isNull():
        continue
    shape = obj.Shape
    box = shape.BoundBox
    bounds = tuple(round(value, 2) for value in (
        box.XMin, box.YMin, box.ZMin, box.XMax, box.YMax, box.ZMax
    ))
    print(obj.Name, obj.Label, "solids", len(shape.Solids), "faces", len(shape.Faces),
          "edges", len(shape.Edges), "vertices", len(shape.Vertexes), "bounds", bounds)
