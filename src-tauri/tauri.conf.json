{
  "productName": "Kohlrausch Konfig",
  "version": "1.2.2",
  "identifier": "com.emtypyie.kohlrausch",
  "build": {
    "frontendDist": "./ui",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kohlrausch Konfig",
        "width": 1280,
        "height": 720,
        "minWidth": 1140,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false
      },
      {
        "label": "splash",
        "title": "Kohlrausch Konfig",
        "url": "splash.html",
        "width": 900,
        "height": 460,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "MIT",
    "licenseFile": "LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
